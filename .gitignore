# Build output
/build/
/android/.gradle/
/android/build/
/android/app/build/
/android/app/.cxx/
/android/local.properties
/captures/
/out/

# Fetched by scripts/fetch-deps.ps1 (pinned there)
/third_party/SDL/
/third_party/volk/
/third_party/vulkan-headers/
/third_party/enet/

# The release key (scripts/release-key.ps1, docs/RELEASE_PIPELINE.md): never committed, the repository is public
/keys/
*.keystore
*.jks
*.p12
*.pfx

# Local tooling
/.vscode/
/.idea/
*.user
*.log
__pycache__/

# Rendered audio previews: the mp3 copies are kept, the wav masters are regenerated by design/tools
/design/music/previews/*.wav
