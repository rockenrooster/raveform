# M7 (design/screens.md "Credits (M7)"): the credits and licences screen's text, generated at configure time from the fetched
# sources (each library's licence as it ships it, never retyped) into ${RF_GEN}/credits.inc. Every third-party library this
# build links is listed in RF_LINKED_THIRD_PARTY where it is linked; one without an entry here fails the configure.
#
# Where a library's own licence file is not among the fetched sources (Oboe and Android Frame Pacing come as Maven packages,
# the Vulkan headers as the SDK's include directory), its licence's text is read from the toolchain's copy of that licence:
# the Apache License 2.0 as the LLVM project ships it (the NDK's NOTICE, llvm-mingw's LICENSE.TXT), and the Vulkan headers'
# own copyright and SPDX line from vulkan_core.h. docs/RELEASE_CHECKLIST.md lists fetching their own files as an open item.

get_filename_component(_rf_cc_bin "${CMAKE_CXX_COMPILER}" DIRECTORY)
get_filename_component(_rf_cc_root "${_rf_cc_bin}" DIRECTORY)
set(RF_LLVM_LICENCE "")
foreach(_cand "${_rf_cc_root}/NOTICE" "${_rf_cc_root}/LICENSE.TXT")
  if(NOT RF_LLVM_LICENCE AND EXISTS "${_cand}")
    file(READ "${_cand}" _txt)
    string(FIND "${_txt}" "The LLVM Project is under the Apache License" _at)
    if(NOT _at EQUAL -1)
      set(RF_LLVM_LICENCE "${_cand}")
    endif()
  endif()
endforeach()

# The LLVM licence (Apache 2.0 with LLVM Exceptions), from its first line to the end of the exceptions; the Apache License 2.0
# alone is the part before the exceptions.
set(RF_TEXT_LLVM "")
set(RF_TEXT_APACHE "")
if(RF_LLVM_LICENCE)
  file(READ "${RF_LLVM_LICENCE}" _txt)
  string(FIND "${_txt}" "The LLVM Project is under the Apache License" _a)
  string(SUBSTRING "${_txt}" ${_a} -1 _txt)
  string(FIND "${_txt}" "Software from third parties included in the LLVM Project" _z)
  string(SUBSTRING "${_txt}" 0 ${_z} RF_TEXT_LLVM)
  string(REGEX REPLACE "=+[ \t\r\n]*$" "" RF_TEXT_LLVM "${RF_TEXT_LLVM}")
  # (from the line that is the heading "Apache License" alone)
  string(REGEX MATCH "\n[ \t]*Apache License[ \t]*\r?\n" _m "${RF_TEXT_LLVM}")
  string(FIND "${RF_TEXT_LLVM}" "${_m}" _s)
  string(FIND "${RF_TEXT_LLVM}" "---- LLVM Exceptions" _e)
  if(_m STREQUAL "" OR _s EQUAL -1 OR _e EQUAL -1)
    message(FATAL_ERROR "credits: the Apache License 2.0 was not found in ${RF_LLVM_LICENCE}")
  endif()
  math(EXPR _from "${_s} + 1")
  math(EXPR _len "${_e} - ${_from}")
  string(SUBSTRING "${RF_TEXT_LLVM}" ${_from} ${_len} RF_TEXT_APACHE)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${RF_LLVM_LICENCE}")
endif()

# The Vulkan headers' own notice: the comment block at the top of vulkan_core.h.
set(RF_TEXT_VULKAN "")
set(_vk "${RF_TP}/vulkan-headers/include/vulkan/vulkan_core.h")
if(EXISTS "${_vk}")
  file(STRINGS "${_vk}" _lines LIMIT_COUNT 12)
  foreach(_l IN LISTS _lines)
    if(_l MATCHES "^\\*\\*? ?(Copyright|SPDX)" OR _l MATCHES "^\\*\\* (Copyright|SPDX)")
      string(REGEX REPLACE "^\\*+ ?" "" _l "${_l}")
      string(APPEND RF_TEXT_VULKAN "${_l}\n")
    endif()
  endforeach()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_vk}")
endif()

function(rf_read_licence out path)
  if(EXISTS "${path}")
    file(READ "${path}" _t)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
    set(${out} "${_t}" PARENT_SCOPE)
  else()
    set(${out} "" PARENT_SCOPE)
  endif()
endfunction()

# The entries: the credit line (screens.md's BUILT ON), the licence text.
rf_read_licence(_sdl "${RF_TP}/SDL/LICENSE.txt")
rf_read_licence(_enet "${RF_TP}/enet/LICENSE")
rf_read_licence(_volk "${RF_TP}/volk/LICENSE.md")
set(RF_CREDIT_SDL "SDL 3  (ZLIB LICENCE)")
set(RF_CREDIT_TEXT_SDL "${_sdl}")
set(RF_CREDIT_OBOE "OBOE  (APACHE 2.0)")
set(RF_CREDIT_TEXT_OBOE "${RF_TEXT_APACHE}")
set(RF_CREDIT_FRAME_PACING "ANDROID FRAME PACING  (APACHE 2.0)")
set(RF_CREDIT_TEXT_FRAME_PACING "${RF_TEXT_APACHE}")
set(RF_CREDIT_ENET "ENET  (MIT)")
set(RF_CREDIT_TEXT_ENET "${_enet}")
set(RF_CREDIT_VOLK "VOLK  (MIT)")
set(RF_CREDIT_TEXT_VOLK "${_volk}")
set(RF_CREDIT_VULKAN_HEADERS "VULKAN HEADERS  (APACHE 2.0, MIT)")
set(RF_CREDIT_TEXT_VULKAN_HEADERS "${RF_TEXT_VULKAN}\n${RF_TEXT_APACHE}")
# (not in screens.md's list, but linked: the C++ standard library, shipped as libc++_shared.so on Android and linked statically
# into the desktop build)
set(RF_CREDIT_LIBCXX "LLVM LIBC++  (APACHE 2.0 WITH LLVM EXCEPTIONS)")
set(RF_CREDIT_TEXT_LIBCXX "${RF_TEXT_LLVM}")

set(_out "// Generated by cmake/Credits.cmake from the fetched sources - do not edit.\n")
string(APPEND _out "// design/screens.md \"Credits (M7)\": the libraries this build links, each with its licence as it ships it.\n")
string(APPEND _out "static const CreditEntry kCredits[] = {\n")
# (screens.md's order; then what the page does not list)
set(_order SDL OBOE FRAME_PACING ENET VOLK VULKAN_HEADERS LIBCXX)
foreach(_id IN LISTS RF_LINKED_THIRD_PARTY)
  if(NOT DEFINED RF_CREDIT_${_id} OR NOT _id IN_LIST _order)
    message(FATAL_ERROR "credits: the linked third-party library ${_id} has no entry in cmake/Credits.cmake (design/screens.md, Credits (M7))")
  endif()
endforeach()
foreach(_id IN LISTS _order)
  if(NOT _id IN_LIST RF_LINKED_THIRD_PARTY)
    continue()
  endif()
  set(_text "${RF_CREDIT_TEXT_${_id}}")
  if(_text STREQUAL "" OR _text STREQUAL "\n")
    message(FATAL_ERROR "credits: ${_id}'s licence text was not found in the fetched sources (cmake/Credits.cmake)")
  endif()
  string(FIND "${_text}" ")RFTEXT\"" _clash)
  if(NOT _clash EQUAL -1)
    message(FATAL_ERROR "credits: ${_id}'s licence contains the raw-string delimiter")
  endif()
  string(APPEND _out "    {\"${RF_CREDIT_${_id}}\", R\"RFTEXT(${_text})RFTEXT\"},\n")
endforeach()
string(APPEND _out "};\n")
file(WRITE "${RF_GEN}/credits.inc.tmp" "${_out}")
configure_file("${RF_GEN}/credits.inc.tmp" "${RF_GEN}/credits.inc" COPYONLY)  # (rewritten only when it changes)
