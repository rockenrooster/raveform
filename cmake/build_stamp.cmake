# The build stamp (the owner, 2026-11-14: "include a version # with build date at the bottom right at the main menu"): run as
# `cmake -DOUT=<header> -DSRC=<repo root> -DVERSION=<x.y.z> -P build_stamp.cmake` on every build. It writes the header only when
# its text changes (to the minute), so only src/core/build_info.cpp recompiles. The commit is read from .git without git itself
# (the Android build's CMake may not have it on its path); a checkout without .git gets none.
string(TIMESTAMP RF_STAMP_DATE "%Y-%m-%d %H:%M")
set(RF_STAMP_HASH "")
if(EXISTS "${SRC}/.git/HEAD")
  file(READ "${SRC}/.git/HEAD" head)
  string(STRIP "${head}" head)
  if(head MATCHES "^ref: (.+)$")
    set(ref "${CMAKE_MATCH_1}")
    if(EXISTS "${SRC}/.git/${ref}")
      file(READ "${SRC}/.git/${ref}" hash)
      string(STRIP "${hash}" hash)
    elseif(EXISTS "${SRC}/.git/packed-refs")
      file(STRINGS "${SRC}/.git/packed-refs" lines REGEX " ${ref}$")
      if(lines)
        list(GET lines 0 line)
        string(REGEX REPLACE " .*$" "" hash "${line}")
      endif()
    endif()
  else()
    set(hash "${head}")
  endif()
  if(hash)
    string(SUBSTRING "${hash}" 0 7 RF_STAMP_HASH)
    string(TOUPPER "${RF_STAMP_HASH}" RF_STAMP_HASH)
  endif()
endif()
set(text "// Written by cmake/build_stamp.cmake on every build; do not edit.\n#define RF_VERSION \"${VERSION}\"\n#define RF_BUILD_DATE \"${RF_STAMP_DATE}\"\n#define RF_BUILD_COMMIT \"${RF_STAMP_HASH}\"\n")
set(old "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
  file(WRITE "${OUT}" "${text}")
endif()
